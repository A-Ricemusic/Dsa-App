# Convex public deployment URL. `bunx convex dev` normally writes this for you.
CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS AuthKit configuration. The client ID is public and is used by both
# the Vite frontend and Convex auth configuration.
WORKOS_CLIENT_ID=client_your_client_id
# Optional locally; defaults to the current origin plus /callback.
WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Production uses a same-origin server session so refresh tokens never enter
# JavaScript-accessible storage. Add both values to Vercel before deploying.
WORKOS_API_KEY=sk_your_api_key
# Generate once with `openssl rand -base64 32`, store it as a Vercel secret,
# and keep it stable across deployments. Rotating it invalidates session cookies.
WORKOS_COOKIE_PASSWORD=replace_with_at_least_32_random_characters

# Convex deployments also need WORKOS_CLIENT_ID configured in their dashboard.
