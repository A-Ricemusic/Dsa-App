# Convex deployment values. `bunx convex dev` normally writes these for you.
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# WorkOS AuthKit browser configuration. These values are public.
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Convex deployments also need WORKOS_CLIENT_ID configured in their dashboard.
